{
  "name": "reusable-resume-builder",
  "version": "0.0.0",
  "private": true,
  "description": "Local resume builder: a shared library of experiences, projects, accomplishments and wording variants, assembled into JSON Resume documents per role.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "api": "node src/server/main.ts",
    "demo:seed": "node src/server/demo-seed.ts",
    "demo": "node src/server/main.ts --demo"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@jsonresume/schema": "1.11.0",
    "hono": "4.13.21",
    "jsonresume-theme-even": "0.27.0",
    "parse5": "8.1.1",
    "pdfjs-dist": "6.5.438",
    "puppeteer": "25.18.1",
    "resumed": "7.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
