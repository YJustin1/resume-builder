    {
      "case": "T24",
      "description": "Dates outside the pinned schema pattern, impossible calendar dates, and end-before-start are rejected on write; the record is unchanged.",
      "steps": [
        {
          "action": "editExperience",
          "id": "e1",
          "patch": {
            "startDate": "0999-12-31"
          },
          "status": 400,
          "code": "INVALID_INPUT"
        },
        {
          "action": "editExperience",
          "id": "e1",
          "patch": {
            "startDate": "2025-02-30"
          },
          "status": 400,
          "code": "INVALID_INPUT"
        },
        {
          "action": "editExperience",
          "id": "e1",
          "patch": {
            "endDate": "2025-04"
          },
          "status": 400,
          "code": "INVALID_INPUT",
          "expectedAfterThisStep": {
            "r-security": "file:security.expected.json",
            "r-engineering": "file:engineering.expected.json"
          }
        },
        {
          "action": "editExperience",
          "id": "e1",
          "patch": {
            "startDate": "2025"
          },
          "status": 200,
          "expectedExportFields": [
            {
              "resume": "r-security",
              "path": "work[0].startDate",
              "value": "2025"
            },
            {
              "resume": "r-engineering",
              "path": "work[1].startDate",
              "value": "2025"
            }
          ]
        }
      ],
      "note": "Steps 1-3 are rejected and must leave both exports equal to the original files. Step 4 is valid at common precision (2025 vs 2025-08-01) and changes only the exported startDate of Northwind Lab."
    },
