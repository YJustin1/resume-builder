              "name": "Security"
            }
          ],
          "expectedExportFields": [
            {
              "resume": "r-security",
              "path": "basics",
              "value": {
                "name": "Sample Candidate",
                "email": "candidate@example.org"
              }
            },
            {
              "resume": "r-engineering",
              "path": "basics",
              "value": {
                "name": "Sample Candidate",
                "email": "candidate@example.org"
              }
            }
          ]
        },
        {
          "action": "editProfile",
          "patch": {
            "email": null
          },
          "status": 200,
          "expectedImpact": [
            {
              "id": "r-engineering",
              "name": "Engineering"
            },
            {
              "id": "r-security",
              "name": "Security"
            }
          ],
          "expectedExportFields": [
            {
              "resume": "r-security",
              "path": "basics",
              "value": {
                "name": "Sample Candidate"
              }
            },
            {
              "resume": "r-engineering",
              "path": "basics",
              "value": {
                "name": "Sample Candidate"
              }
            }
          ]
        }
      ],
      "note": "Profile edits use PATCH /api/profile (partial body), so a missing field can never be the reason for a 400. The valid-email control uses the same body shape as the rejected email steps. Impact steps belong to the Phase 2 gate."
    }
