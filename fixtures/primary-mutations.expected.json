      "case": "T25",
      "description": "Schema-constrained fields are validated on write with the pinned validator; empty strings are rejected; null clears an optional field.",
      "steps": [
        {
          "action": "editProfile",
          "patch": {
            "email": "not-an-email"
          },
          "status": 400,
          "code": "INVALID_INPUT",
          "expectedAfterThisStep": {
